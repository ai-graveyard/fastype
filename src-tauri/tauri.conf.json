{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FasType",
  "version": "0.1.0",
  "identifier": "com.ai-graveyard.fastype",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi"],
    "createUpdaterArtifacts": false,
    "category": "Productivity",
    "copyright": "Copyright © 2026 FasType contributors",
    "shortDescription": "轻量 Markdown 写作与排版工具",
    "longDescription": "FasType 是一个无需账号、没有后端的轻量 Markdown 写作工具：编辑 Markdown、排成小红书分页图片或公众号富文本，并用自带 API Key 做轻量 AI 改写。",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
