{
  "name": "fastype",
  "version": "0.1.0",
  "private": true,
  "description": "无需账号、没有后端的 Markdown 写作工具，一份正文同时排出小红书图片和微信公众号富文本。",
  "license": "MIT",
  "homepage": "https://fast.lovtype.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-graveyard/fastype.git"
  },
  "bugs": {
    "url": "https://github.com/ai-graveyard/fastype/issues"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
